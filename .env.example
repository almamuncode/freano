# PostgreSQL connection string (use a free Neon/Supabase/Railway DB if you don't want to install locally)
DATABASE_URL="postgresql://user:password@localhost:5432/freano"

# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
