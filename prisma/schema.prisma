// Freano database schema
// Run: npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  INCOME
  EXPENSE
}

// Lets a user tag a transaction as personal, family, or business spend/income
enum Scope {
  PERSONAL
  FAMILY
  BUSINESS
}

enum PaymentMethod {
  CASH
  BKASH
  NAGAD
  ROCKET
  BANK_TRANSFER
  CARD
  OTHER
}

enum Account {
  BANK
  SAVINGS
  POCKET_MONEY
  WALLET
}

enum Role {
  USER
  ADMIN
}

enum LoanDirection {
  LENT
  BORROWED
}

enum LoanStatus {
  OPEN
  PAID
}

enum ProjectPaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  image         String?        @db.Text
  phone         String?
  profession    String?
  currentCity   String?
  dateOfBirth   DateTime?
  passwordHash  String
  currency      String        @default("BDT")
  role          Role          @default(USER)
  isActive      Boolean       @default(true) // false = suspended by an admin
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  transactions  Transaction[]
  categories    Category[]
  banks         Bank[]
  wallets       Wallet[]
  passwordResetTokens PasswordResetToken[]
  loans         Loan[]
  projects      Project[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
}

model Category {
  id        String           @id @default(cuid())
  name      String
  type      TransactionType
  icon      String?          // emoji or icon key, e.g. "🍔"
  isDefault Boolean          @default(false)

  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions Transaction[]

  @@unique([userId, name, type])
}

model Bank {
  id           String        @id @default(cuid())
  name         String
  details      String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Wallet {
  id           String        @id @default(cuid())
  name         String
  details      String?
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model Transaction {
  id            String           @id @default(cuid())
  type          TransactionType
  amount        Decimal          @db.Decimal(12, 2)
  currency      String           @default("BDT")
  scope         Scope            @default(PERSONAL)
  paymentMethod PaymentMethod    @default(CASH)
  account       Account          @default(BANK)
  bankId        String?
  bank          Bank?            @relation(fields: [bankId], references: [id], onDelete: Cascade)
  walletId      String?
  wallet        Wallet?          @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transferId    String?
  isDeposit     Boolean          @default(false)

  // "source" for income (e.g. client name, project), "payee" for expense (e.g. shop, family member)
  source        String
  note          String?

  // Store the exact moment of the transaction (date + time together)
  occurredAt    DateTime

  categoryId    String?
  category      Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([userId, occurredAt])
  @@index([userId, type])
  @@index([userId, account])
  @@index([bankId])
  @@index([walletId])
  @@index([userId, transferId])
}

model Loan {
  id            String        @id @default(cuid())
  direction     LoanDirection
  person        String
  phone         String?
  principal     Decimal       @db.Decimal(12, 2)
  interestRate  Decimal       @default(0) @db.Decimal(5, 2)
  dueDate       DateTime?
  status        LoanStatus    @default(OPEN)
  note          String?
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      LoanPayment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId, status])
  @@index([userId, direction])
}

model LoanPayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  note      String?
  loanId    String
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId, paidAt])
}

model Project {
  id            String               @id @default(cuid())
  title         String
  client        String
  phone         String?
  agreedAmount  Decimal              @db.Decimal(12, 2)
  paidAmount    Decimal              @default(0) @db.Decimal(12, 2)
  status        ProjectPaymentStatus @default(UNPAID)
  dueDate       DateTime?
  note          String?
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments      ProjectPayment[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([userId, status])
  @@index([userId, dueDate])
}

model ProjectPayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime @default(now())
  note      String?
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, paidAt])
}
